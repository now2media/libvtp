prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: vtp
Description: Low-latency video and audio transmission library over local networks
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lvtp
Cflags: -I${includedir}
